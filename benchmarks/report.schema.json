{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thoth-mem benchmark report v1",
  "type": "object",
  "required": ["schema", "created_at", "dataset", "candidate", "conditions", "environment", "budgets", "primary_metrics", "promotion_gate", "metrics", "provenance", "fallback_controls", "operational_errors", "unavailable", "promotion"],
  "properties": {
    "schema": {"const": "thoth-mem.benchmark-report.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset": {"type": "object", "required": ["name", "version", "license", "availability", "corpus_hash", "query_hash"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "availability": {"type": "string", "minLength": 1}, "corpus_hash": {"$ref": "#/$defs/hash"}, "query_hash": {"$ref": "#/$defs/hash"}}},
    "candidate": {"type": "object", "required": ["id", "config_hash", "config"], "properties": {"id": {"type": "string", "minLength": 1}, "config_hash": {"$ref": "#/$defs/hash"}, "config": {"type": "object"}}},
    "conditions": {"type": "object", "required": ["run_config_hash", "query_order_hash", "reader", "scorer", "seed", "timeout_ms", "retries"], "properties": {"run_config_hash": {"$ref": "#/$defs/hash"}, "query_order_hash": {"$ref": "#/$defs/hash"}, "reader": {"$ref": "#/$defs/executor"}, "scorer": {"$ref": "#/$defs/executor"}, "seed": {"type": "integer"}, "timeout_ms": {"type": "integer", "minimum": 1}, "retries": {"type": "integer", "minimum": 0}}},
    "environment": {"type": "object", "required": ["runtime", "runtime_version", "platform", "arch"], "properties": {"runtime": {"type": "string", "minLength": 1}, "runtime_version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "arch": {"type": "string", "minLength": 1}}},
    "budgets": {"type": "object", "required": ["candidate_k", "context_tokens"], "properties": {"candidate_k": {"type": "integer", "minimum": 1}, "context_tokens": {"type": "integer", "minimum": 1}}},
    "primary_metrics": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/primaryMetric"}},
    "promotion_gate": {"type": "object", "required": ["provenance_coverage", "resource_ceilings"], "properties": {"provenance_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "resource_ceilings": {"$ref": "#/$defs/resourceCeilings"}}},
    "metrics": {"type": "object", "required": ["retrieval", "evidence", "answer", "agent", "progressive", "compaction", "resources"], "properties": {"retrieval": {"type": "object"}, "evidence": {"type": "object"}, "answer": {"type": "object"}, "agent": {"type": "object"}, "progressive": {"type": "object", "required": ["compact_returned_chars", "context_returned_chars", "source_chars", "evidence_chars", "full_chars", "truncated_chars", "full_fetches", "avoided_full_fetches", "escalation_rate", "compression_ratio"]}, "compaction": {"type": "object", "required": ["checkpoints", "recoveries", "recovery_success", "delivered_sources"]}, "resources": {"$ref": "#/$defs/resources"}}},
    "provenance": {"type": "object", "required": ["coverage", "source_ids"], "properties": {"coverage": {"type": "number", "minimum": 0, "maximum": 1}, "source_ids": {"type": "array", "items": {"type": "string"}}}},
    "fallback_controls": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/fallbackControl"}},
    "operational_errors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/operationalError"}},
    "unavailable": {"type": "array", "items": {"type": "object", "required": ["id", "reason"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]{3,64}$"}, "reason": {"type": "string", "pattern": "^[a-z_]{3,64}$"}}}},
    "promotion": {"type": "object", "required": ["decision", "reasons"], "properties": {"decision": {"enum": ["promoted", "rejected", "incomplete"]}, "reasons": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor": {"type": "object", "required": ["id", "settings_hash"], "properties": {"id": {"type": "string", "minLength": 1}, "settings_hash": {"$ref": "#/$defs/hash"}}},
    "primaryMetric": {"type": "object", "required": ["namespace", "metric", "gate"], "properties": {"namespace": {"enum": ["retrieval", "answer", "agent"]}, "metric": {"type": "string", "minLength": 1}, "gate": {"enum": ["relative_gain", "non_regression"]}, "threshold": {"type": "number", "exclusiveMinimum": 0}}},
    "resourceCeilings": {"type": "object", "required": ["latency_p95_ms", "peak_memory_bytes", "database_bytes", "model_bytes", "network_calls", "llm_calls", "injected_tokens"], "properties": {"latency_p95_ms": {"type": "number", "minimum": 1}, "peak_memory_bytes": {"type": "number", "minimum": 1}, "database_bytes": {"type": "number", "minimum": 1}, "model_bytes": {"type": "number", "minimum": 1}, "network_calls": {"type": "number", "minimum": 1}, "llm_calls": {"type": "number", "minimum": 1}, "injected_tokens": {"type": "number", "minimum": 1}}},
    "fallbackControl": {"type": "object", "required": ["scenario", "observed_state", "control_lexical_hits", "fallback_lexical_hits", "source_ids"], "properties": {"scenario": {"enum": ["disabled", "missing", "stale", "rebuilding", "failed", "source_mismatched"]}, "observed_state": {"enum": ["disabled", "missing", "stale", "rebuilding", "degraded"]}, "control_lexical_hits": {"type": "integer", "minimum": 0}, "fallback_lexical_hits": {"type": "integer", "minimum": 0}, "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "operationalError": {"type": "object", "required": ["operation", "code", "message", "retryable"], "properties": {"operation": {"type": "string", "pattern": "^[a-z_]{3,64}$"}, "code": {"type": "string", "pattern": "^[a-z_]{3,64}$"}, "message": {"type": "string", "minLength": 1, "maxLength": 200}, "retryable": {"type": "boolean"}}},
    "nonNegative": {"type": "number", "minimum": 0},
    "resources": {"type": "object", "required": ["latency_p50_ms", "latency_p95_ms", "ingestion_ms", "startup_ms", "peak_memory_bytes", "database_bytes", "model_bytes", "network_calls", "llm_calls", "injected_tokens", "returned_chars", "truncated_chars", "samples"], "properties": {"latency_p50_ms": {"$ref": "#/$defs/nonNegative"}, "latency_p95_ms": {"$ref": "#/$defs/nonNegative"}, "ingestion_ms": {"$ref": "#/$defs/nonNegative"}, "startup_ms": {"$ref": "#/$defs/nonNegative"}, "peak_memory_bytes": {"$ref": "#/$defs/nonNegative"}, "database_bytes": {"$ref": "#/$defs/nonNegative"}, "model_bytes": {"$ref": "#/$defs/nonNegative"}, "network_calls": {"$ref": "#/$defs/nonNegative"}, "llm_calls": {"$ref": "#/$defs/nonNegative"}, "injected_tokens": {"$ref": "#/$defs/nonNegative"}, "returned_chars": {"$ref": "#/$defs/nonNegative"}, "truncated_chars": {"$ref": "#/$defs/nonNegative"}, "samples": {"type": "object", "required": ["latency_ms", "memory_bytes"], "properties": {"latency_ms": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/nonNegative"}}, "memory_bytes": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/nonNegative"}}}}}}
  }
}
