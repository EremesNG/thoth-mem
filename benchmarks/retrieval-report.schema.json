{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thoth-mem retrieval benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "dataset", "candidate", "conditions", "environment", "metrics", "provenance", "queries", "errors", "promotion"],
  "properties": {
    "schema": {"const": "thoth-mem.retrieval-benchmark-report.v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "corpus_hash", "query_hash", "record_count", "evaluated_count", "exclusions"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset", "filename", "revision", "sha256", "bytes", "license"],
          "properties": {
            "dataset": {"type": "string", "minLength": 1},
            "filename": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "sha256": {"$ref": "#/$defs/hash"},
            "bytes": {"type": "integer", "minimum": 1},
            "license": {"type": "string", "minLength": 1}
          }
        },
        "corpus_hash": {"$ref": "#/$defs/hash"},
        "query_hash": {"$ref": "#/$defs/hash"},
        "record_count": {"type": "integer", "minimum": 1},
        "evaluated_count": {"type": "integer", "minimum": 1},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config_hash", "config"],
      "properties": {"id": {"type": "string", "minLength": 1}, "config_hash": {"$ref": "#/$defs/hash"}, "config": {"type": "object", "required": ["lexical_strategy"], "properties": {"lexical_strategy": {"$ref": "#/$defs/lexicalStrategy"}}}}
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_order", "query_order_hash", "candidate_k", "candidate_payload_utf16_code_units", "delivery"],
      "properties": {
        "query_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "query_order_hash": {"$ref": "#/$defs/hash"},
        "candidate_k": {"const": 20},
        "candidate_payload_utf16_code_units": {"const": 20000},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["utf16_code_units", "estimated_tokens", "token_basis"],
          "properties": {"utf16_code_units": {"const": 4000}, "estimated_tokens": {"const": 1000}, "token_basis": {"const": "estimated_chars_div_4"}}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "runtime_version", "platform", "arch"],
      "properties": {"runtime": {"type": "string", "minLength": 1}, "runtime_version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}, "arch": {"type": "string", "minLength": 1}}
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking", "delivery", "resources"],
      "properties": {"ranking": {"$ref": "#/$defs/scoreSummary"}, "delivery": {"$ref": "#/$defs/scoreSummary"}, "resources": {"$ref": "#/$defs/resources"}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "mappings"],
      "properties": {"coverage": {"const": 1}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}}
    },
    "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reasons"],
      "properties": {"decision": {"const": "incomplete"}, "reasons": {"type": "array", "contains": {"const": "lexical_baseline_only_no_candidate_comparison"}}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonNegative": {"type": "number", "minimum": 0},
    "unitInterval": {"type": "number", "minimum": 0, "maximum": 1},
    "stringIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "orderedStringIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "lexicalStrategy": {"type": "object", "additionalProperties": false, "required": ["id", "config_hash"], "properties": {"id": {"enum": ["all-prefix-v1", "any-prefix-v1", "all-then-any-prefix-v1", "strict-selected-any-cap5-rrf-v1"]}, "config_hash": {"$ref": "#/$defs/hash"}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["question_id", "reason"], "properties": {"question_id": {"type": "string", "minLength": 1}, "reason": {"const": "abstention"}}},
    "metricSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_any_at_1", "recall_at_1", "recall_all_at_1", "recall_any_at_5", "recall_at_5", "recall_all_at_5", "recall_any_at_10", "recall_at_10", "recall_all_at_10", "recall_any_at_20", "recall_at_20", "recall_all_at_20", "mrr_any", "ndcg_at_10"],
      "properties": {
        "recall_any_at_1": {"$ref": "#/$defs/unitInterval"}, "recall_at_1": {"$ref": "#/$defs/unitInterval"}, "recall_all_at_1": {"$ref": "#/$defs/unitInterval"},
        "recall_any_at_5": {"$ref": "#/$defs/unitInterval"}, "recall_at_5": {"$ref": "#/$defs/unitInterval"}, "recall_all_at_5": {"$ref": "#/$defs/unitInterval"},
        "recall_any_at_10": {"$ref": "#/$defs/unitInterval"}, "recall_at_10": {"$ref": "#/$defs/unitInterval"}, "recall_all_at_10": {"$ref": "#/$defs/unitInterval"},
        "recall_any_at_20": {"$ref": "#/$defs/unitInterval"}, "recall_at_20": {"$ref": "#/$defs/unitInterval"}, "recall_all_at_20": {"$ref": "#/$defs/unitInterval"},
        "mrr_any": {"$ref": "#/$defs/unitInterval"}, "ndcg_at_10": {"$ref": "#/$defs/unitInterval"}, "count": {"type": "integer", "minimum": 1}
      }
    },
    "scoreAggregate": {"allOf": [{"$ref": "#/$defs/metricSet"}, {"type": "object", "required": ["count"], "properties": {"count": {"type": "integer", "minimum": 1}}}]},
    "scoreSummary": {"type": "object", "additionalProperties": false, "required": ["overall", "by_question_type"], "properties": {"overall": {"$ref": "#/$defs/scoreAggregate"}, "by_question_type": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/scoreAggregate"}}}},
    "sampleSummary": {"type": "object", "additionalProperties": false, "required": ["p50", "p95", "samples"], "properties": {"p50": {"$ref": "#/$defs/nonNegative"}, "p95": {"$ref": "#/$defs/nonNegative"}, "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonNegative"}}}},
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["retrieval_latency_ms", "delivery_latency_ms", "ingestion_ms", "startup_ms", "rss_bytes", "sqlite_bytes", "text", "network_calls", "model_calls", "llm_calls"],
      "properties": {
        "retrieval_latency_ms": {"$ref": "#/$defs/sampleSummary"}, "delivery_latency_ms": {"$ref": "#/$defs/sampleSummary"}, "ingestion_ms": {"$ref": "#/$defs/sampleSummary"}, "startup_ms": {"$ref": "#/$defs/sampleSummary"},
        "rss_bytes": {"type": "object", "additionalProperties": false, "required": ["peak", "samples"], "properties": {"peak": {"$ref": "#/$defs/nonNegative"}, "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonNegative"}}}},
        "sqlite_bytes": {"type": "object", "additionalProperties": false, "required": ["total", "p50", "p95", "samples"], "properties": {"total": {"$ref": "#/$defs/nonNegative"}, "p50": {"$ref": "#/$defs/nonNegative"}, "p95": {"$ref": "#/$defs/nonNegative"}, "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonNegative"}}}},
        "text": {"type": "object", "additionalProperties": false, "required": ["corpus_utf16_code_units", "query_utf16_code_units", "ranked_source_utf16_code_units", "ranked_evidence_utf16_code_units", "ranked_returned_utf16_code_units", "ranked_truncated_utf16_code_units", "delivery_source_utf16_code_units", "delivery_evidence_utf16_code_units", "delivered_utf16_code_units", "delivery_truncated_utf16_code_units", "estimated_tokens"], "properties": {"corpus_utf16_code_units": {"type": "integer", "minimum": 0}, "query_utf16_code_units": {"type": "integer", "minimum": 0}, "ranked_source_utf16_code_units": {"type": "integer", "minimum": 0}, "ranked_evidence_utf16_code_units": {"type": "integer", "minimum": 0}, "ranked_returned_utf16_code_units": {"type": "integer", "minimum": 0}, "ranked_truncated_utf16_code_units": {"type": "integer", "minimum": 0}, "delivery_source_utf16_code_units": {"type": "integer", "minimum": 0}, "delivery_evidence_utf16_code_units": {"type": "integer", "minimum": 0}, "delivered_utf16_code_units": {"type": "integer", "minimum": 0}, "delivery_truncated_utf16_code_units": {"type": "integer", "minimum": 0}, "estimated_tokens": {"type": "object", "additionalProperties": false, "required": ["corpus", "queries", "ranked_source", "ranked_returned", "ranked_truncated", "delivery_source", "delivered", "delivery_truncated"], "properties": {"corpus": {"type": "integer", "minimum": 0}, "queries": {"type": "integer", "minimum": 0}, "ranked_source": {"type": "integer", "minimum": 0}, "ranked_returned": {"type": "integer", "minimum": 0}, "ranked_truncated": {"type": "integer", "minimum": 0}, "delivery_source": {"type": "integer", "minimum": 0}, "delivered": {"type": "integer", "minimum": 0}, "delivery_truncated": {"type": "integer", "minimum": 0}}}}},
        "network_calls": {"const": 0}, "model_calls": {"const": 0}, "llm_calls": {"const": 0}
      }
    },
    "mapping": {"type": "object", "additionalProperties": false, "required": ["question_id", "source_id", "session_index", "session_id", "memory_id", "evidence_id"], "properties": {"question_id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "session_index": {"type": "integer", "minimum": 0}, "session_id": {"type": "string", "minLength": 1}, "memory_id": {"type": "string", "minLength": 1}, "evidence_id": {"type": "string", "minLength": 1}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["requested_utf16_code_units", "returned_utf16_code_units", "truncated_utf16_code_units", "source_utf16_code_units", "evidence_utf16_code_units", "full_utf16_code_units", "compression_ratio", "token_basis"], "properties": {"requested_utf16_code_units": {"type": "integer", "minimum": 1}, "returned_utf16_code_units": {"type": "integer", "minimum": 0}, "truncated_utf16_code_units": {"type": "integer", "minimum": 0}, "source_utf16_code_units": {"type": "integer", "minimum": 0}, "evidence_utf16_code_units": {"type": "integer", "minimum": 0}, "full_utf16_code_units": {"type": "integer", "minimum": 0}, "compression_ratio": {"$ref": "#/$defs/unitInterval"}, "token_basis": {"const": "estimated_chars_div_4"}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["question_id", "question_type", "query_plan_hash", "gold_session_ids", "gold_source_ids", "ranked_source_ids", "ranked_session_ids", "delivered_source_ids", "delivered_session_ids", "gold_ranks", "ranking_budget", "delivery_budget", "ranking", "delivery"], "properties": {"question_id": {"type": "string", "minLength": 1}, "question_type": {"type": "string", "minLength": 1}, "query_plan_hash": {"$ref": "#/$defs/hash"}, "gold_session_ids": {"$ref": "#/$defs/stringIds"}, "gold_source_ids": {"$ref": "#/$defs/stringIds"}, "ranked_source_ids": {"$ref": "#/$defs/stringIds"}, "ranked_session_ids": {"$ref": "#/$defs/orderedStringIds"}, "delivered_source_ids": {"$ref": "#/$defs/stringIds"}, "delivered_session_ids": {"$ref": "#/$defs/orderedStringIds"}, "gold_ranks": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}, "ranking_budget": {"allOf": [{"$ref": "#/$defs/budget"}, {"type": "object", "properties": {"requested_utf16_code_units": {"const": 20000}}}]}, "delivery_budget": {"allOf": [{"$ref": "#/$defs/budget"}, {"type": "object", "properties": {"requested_utf16_code_units": {"const": 4000}}}]}, "ranking": {"$ref": "#/$defs/metricSet"}, "delivery": {"$ref": "#/$defs/metricSet"}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["question_id", "code", "message"], "properties": {"question_id": {"type": "string", "minLength": 1}, "code": {"type": "string", "pattern": "^[a-z_]{3,64}$"}, "message": {"type": "string", "minLength": 1, "maxLength": 200}}}
  }
}
